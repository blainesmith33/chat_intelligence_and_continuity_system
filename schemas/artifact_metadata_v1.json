{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CICS Artifact Metadata v1",
  "type": "object",
  "properties": {
    "schema_id": {"const": "cics.artifact_metadata.v1"},
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "pattern": "^art_[a-f0-9]{32}$"},
    "status": {"enum": ["STAGED", "APPROVED", "REJECTED", "COMMITTED"]},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "current_revision": {"type": "integer", "minimum": 1},
    "filename": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "staging_locator": {"type": ["string", "null"]},
    "committed_locator": {"type": ["string", "null"]},
    "source_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": "string"}
  },
  "required": ["schema_id", "schema_version", "artifact_id", "status", "content_hash", "created_at_utc", "created_by", "current_revision"],
  "additionalProperties": false
}
