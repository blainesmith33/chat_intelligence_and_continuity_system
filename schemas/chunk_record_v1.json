{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CICS Chunk Record v1",
  "type": "object",
  "properties": {
    "schema_id": {"const": "cics.chunk_record.v1"},
    "schema_version": {"const": 1},
    "chunk_id": {"type": "string", "pattern": "^chk_[a-f0-9]{64}$"},
    "document_id": {"type": "string", "pattern": "^doc_[a-f0-9]{64}$"},
    "chunk_ordinal": {"type": "integer", "minimum": 0},
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message_id", "start_offset", "end_offset"],
        "properties": {
          "message_id": {"type": "string", "pattern": "^msg_[a-f0-9]{64}$"},
          "start_offset": {"type": "integer", "minimum": 0},
          "end_offset": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "content": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chunker_id": {"type": "string", "minLength": 1},
    "chunker_version": {"type": "string", "minLength": 1},
    "chunk_policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_id": {"type": "string", "pattern": "^src_[a-f0-9]{64}$"},
    "language": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "entity_refs": {"type": "array", "items": {"type": "string", "pattern": "^ent_[a-z0-9][a-z0-9._-]*$"}, "uniqueItems": true},
    "token_count": {"type": "integer", "minimum": 0},
    "character_count": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "required": ["schema_id", "schema_version", "chunk_id", "document_id", "chunk_ordinal", "source_spans", "content", "content_hash", "chunker_id", "chunker_version", "chunk_policy_hash"],
  "additionalProperties": false
}
