{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CICS Document Record v1",
  "type": "object",
  "properties": {
    "schema_id": {"const": "cics.document_record.v1"},
    "schema_version": {"const": 1},
    "document_id": {"type": "string", "pattern": "^doc_[a-f0-9]{64}$"},
    "source_id": {"type": "string", "pattern": "^src_[a-f0-9]{64}$"},
    "document_type": {"type": "string", "minLength": 1},
    "parser_id": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "source_locator": {
      "type": "object",
      "required": ["locator_type", "value"],
      "properties": {
        "locator_type": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "native_document_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "required": ["schema_id", "schema_version", "document_id", "source_id", "document_type", "parser_id", "parser_version", "source_locator"],
  "additionalProperties": false
}
