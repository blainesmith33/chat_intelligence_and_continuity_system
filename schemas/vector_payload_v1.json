{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CICS Vector Payload v1",
  "type": "object",
  "properties": {
    "schema_id": {"const": "cics.vector_payload.v1"},
    "schema_version": {"const": 1},
    "chunk_id": {"type": "string", "pattern": "^chk_[a-f0-9]{64}$"},
    "document_id": {"type": "string", "pattern": "^doc_[a-f0-9]{64}$"},
    "chunk_manifest_id": {"type": "string", "minLength": 1},
    "embedding_build_id": {"type": "string", "pattern": "^emb_[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string"},
    "content_ref": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^src_[a-f0-9]{64}$"},
    "message_ids": {"type": "array", "items": {"type": "string", "pattern": "^msg_[a-f0-9]{64}$"}, "uniqueItems": true},
    "section": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "entity_refs": {"type": "array", "items": {"type": "string", "pattern": "^ent_[a-z0-9][a-z0-9._-]*$"}, "uniqueItems": true},
    "chunk_ordinal": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "required": ["schema_id", "schema_version", "chunk_id", "document_id", "chunk_manifest_id", "embedding_build_id", "content_hash"],
  "additionalProperties": false,
  "anyOf": [{"required": ["text"]}, {"required": ["content_ref"]}]
}
