    "wow_ui_source",
    "wow_api",
    "lua_docs",
    "python_docs",
    "yaml_docs",
    "hardware_manuals",
    "coding_principles",
    "notes"
  ],
  "cloud_provider_children": [
    "aws",
    "azure",
    "gcp"
  ],
  "languages": [
    "lua",
    "python",
    "bash",
    "yaml",
    "json",
    "terraform",
    "xml",
    "text",
    "dockerfile",
    "csharp",
    "cpp",
