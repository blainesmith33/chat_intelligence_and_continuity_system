{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CICS Entity Schema v1",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "canonical_name",
    "authority_level",
    "source_basis",
    "status"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "description": "Stable deterministic identifier for the entity"
    },

    "entity_type": {
      "type": "string",
      "enum": [
        "formal_project",
        "candidate_idea",
        "subsystem",
        "corpus_section",
        "non_project_corpus",
        "archive_bucket",
        "infrastructure_component"
      ]
    },

    "canonical_name": {
      "type": "string",
      "minLength": 1
    },

    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },

    "authority_level": {
      "type": "string",
      "enum": [
        "authoritative",
        "supporting",
        "inferred"
      ]
    },

    "source_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "folder_structure",
          "section_map",
          "project_index",
          "charter",
          "mission",
          "rag_evidence",
          "heuristic"
        ]
      },
      "minItems": 1
    },

    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "candidate",
        "subsystem",
        "non_project",
        "unknown"
      ]
    },

    "parent_entity_id": {
      "type": ["string", "null"],
      "default": null
    },

    "related_entity_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },

    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "ref"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "file",
              "chunk",
              "folder",
              "document"
            ]
          },
          "ref": {
            "type": "string"
          }
        }
      },
      "default": []
    },

    "notes": {
      "type": "string",
      "default": ""
    }
  }
}